#!/usr/bin/python3 -I
# Run as root by pam_exec from /etc/pam.d/sudo (pam-sudo here): before the
# fingerprint scan and again before the password prompt. Turns the
# terminal's echo off and drops whatever was typed so far. pam_fprintd leaves
# echo on while it waits, so a stray Enter moved the cursor under the card
# (which is redrawn by relative moves and then landed on the wrong lines) and
# stayed queued for the password prompt as an empty attempt. Canonical mode
# goes off too: ghostty reads canonical without echo as password input and
# draws its lock icon at the cursor, which waits on the card's header during
# the scan, where nothing is typed (sudo sets its own mode for the password).
# The `granted` script turns both back on; if auth fails for good, the shell
# restores its own modes at the next prompt. Always exits 0: it must never
# block sudo. -I: running as root, ignore PYTHON* variables and user site
# packages.
import os
import termios

tty = os.environ.get("PAM_TTY", "")
if tty.startswith("/dev/"):
    try:
        fd = os.open(tty, os.O_RDWR | os.O_NOCTTY)
        try:
            attrs = termios.tcgetattr(fd)
            attrs[3] &= ~(termios.ECHO | termios.ICANON)
            # TCSAFLUSH also discards input that was typed but not yet read
            termios.tcsetattr(fd, termios.TCSAFLUSH, attrs)
        finally:
            os.close(fd)
    except OSError:
        pass
