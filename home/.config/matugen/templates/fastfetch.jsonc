// Generated by matugen from ~/.config/matugen/templates/fastfetch.jsonc - do not edit.
// fastfetch's default module list, coloured like the game's UI from the
// current theme: keys are labels (the theme's structure colour - red in
// Night City, gold in Militech), the title is data (accent), and the logo
// carries both. Without an explicit "modules" array fastfetch prints the logo only.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "{{theme.accent}}",
      "2": "{{theme.structure}}"
    }
  },
  "display": {
    "color": {
      "keys": "{{theme.structure}}",
      "title": "{{theme.accent}}"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
