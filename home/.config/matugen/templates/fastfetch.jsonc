// Generated by matugen from ~/.config/matugen/templates/fastfetch.jsonc - do not edit.
// fastfetch as one of the desktop's panels, coloured from the current theme
// like the game's UI: labels in caps in the structure colour (red in Night
// City, gold in Militech), values are data (accent), and sections open with a
// "//NAME" rule as the sudo panel does. The logo is CachyOS's C without its
// dots (~/.config/fastfetch/logo.txt): the body in structure, its shading in
// accent, so it reads as both CachyOS and the game.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "{{theme.structure}}",
      "2": "{{theme.accent}}"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 11
    },
    "color": {
      "keys": "{{theme.structure}}",
      "title": "{{theme.accent}}",
      "output": "{{theme.accent}}",
      "separator": "{{theme.structure}}"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "━━ //SYSTEM ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
      "outputColor": "{{theme.structure}}"
    },
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "packages", "key": "PACKAGES" },
    { "type": "shell", "key": "SHELL" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "TERMINAL" },
    {
      "type": "custom",
      "format": "━━ //HARDWARE ━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
      "outputColor": "{{theme.structure}}"
    },
    { "type": "host", "key": "HOST" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "DISK" },
    { "type": "display", "key": "DISPLAY" },
    { "type": "battery", "key": "BATTERY" },
    {
      "type": "custom",
      "format": "━━ //THEME ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
      "outputColor": "{{theme.structure}}"
    },
    {
      "type": "command",
      "key": "PALETTE",
      "text": "cat ~/.config/matugen/current 2>/dev/null || echo nightcity"
    },
    { "type": "theme", "key": "GTK" },
    { "type": "icons", "key": "ICONS" },
    { "type": "font", "key": "FONT" },
    "break",
    "colors"
  ]
}
