// Generated by matugen from ~/.config/matugen/templates/fastfetch.jsonc - do not edit.
// fastfetch as the desktop's panels: Omarchy's layout (sections, tree keys
// with Nerd Font icons, a row of palette dots) in NetTech's visual terms (a
// filled strip with dark caps as each section's header, the bottom edge
// ending in a 45-degree cut). Colours come from the current theme, never a
// fixed one: strips and labels in structure, values as data in accent.
// The logo is CachyOS's C without its dots (~/.config/fastfetch/logo.txt).
// @RGB:<key>@ becomes "r;g;b" in theme-set: raw ANSI escapes can't take hex.
// Rebuild this file from the generator in the cachypunk repo history if the
// layout changes; it is plain JSON otherwise.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "{{theme.structure}}",
      "2": "{{theme.accent}}"
    },
    "padding": {
      "top": 2,
      "right": 4,
      "left": 1
    }
  },
  "display": {
    "disableLinewrap": true,
    "separator": " ",
    "key": {
      "width": 15
    },
    "color": {
      "keys": "{{theme.structure}}",
      "output": "{{theme.accent}}"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;@RGB:structure@m\u001b[38;2;@RGB:bg_deep@m\u001b[1m HARDWARE                                           \u001b[0m"
    },
    {
      "type": "host",
      "key": "│ ├󰌢 PC"
    },
    {
      "type": "cpu",
      "key": "│ ├󰍛 CPU",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "│ ├󰢮 GPU",
      "format": "{name}"
    },
    {
      "type": "display",
      "key": "│ ├󰍹 DISPLAY"
    },
    {
      "type": "memory",
      "key": "│ ├󰑭 MEMORY"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊 DISK"
    },
    {
      "type": "battery",
      "key": "│ └󰁹 BATTERY"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;@RGB:structure@m└──────────────────────────────────────────────────╱\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;@RGB:structure@m\u001b[38;2;@RGB:bg_deep@m\u001b[1m SOFTWARE                                           \u001b[0m"
    },
    {
      "type": "os",
      "key": "│ ├󰣇 OS"
    },
    {
      "type": "kernel",
      "key": "│ ├ KERNEL"
    },
    {
      "type": "wm",
      "key": "│ ├ WM"
    },
    {
      "type": "terminal",
      "key": "│ ├ TERMINAL"
    },
    {
      "type": "shell",
      "key": "│ ├ SHELL"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 PACKAGES"
    },
    {
      "type": "command",
      "key": "│ └󰸌 THEME",
      "text": "printf '%s  \u001b[38;2;@RGB:structure@m● \u001b[38;2;@RGB:accent@m● \u001b[38;2;@RGB:green@m● \u001b[38;2;@RGB:yellow@m● \u001b[38;2;@RGB:accent2@m● \u001b[38;2;@RGB:blue@m● \u001b[38;2;@RGB:magenta@m●\u001b[0m' \"$(cat ~/.config/matugen/current 2>/dev/null)\""
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;@RGB:structure@m└──────────────────────────────────────────────────╱\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;@RGB:structure@m\u001b[38;2;@RGB:bg_deep@m\u001b[1m SESSION                                            \u001b[0m"
    },
    {
      "type": "uptime",
      "key": "│ ├󱫐 UPTIME"
    },
    {
      "type": "command",
      "key": "│ └󱦟 OS AGE",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;@RGB:structure@m└──────────────────────────────────────────────────╱\u001b[0m"
    }
  ]
}
