#!/bin/bash
# Refresh AI agent usage records: agent-usage [collector args...]
#
# Runs every agent-usage-<agent> collector next to this script (in parallel)
# and writes each one's JSON record to ~/.local/state/agent-usage/<agent>.json,
# then prints the records of the agents in use as one JSON array for the
# Quickshell bar. Arguments (--force, --limits-only) are passed to every
# collector.
#
# Detection follows Omarchy's agents panel (providerHasData in
# shell/plugins/agents/Main.qml): every collector always prints a record, and
# only records with some usage are kept - prompts, sessions or active days,
# limits, accounts, a balance, or a signed-in plan. So the panel shows a tab
# for exactly the agents in use, and a new agent appears on its own once it
# has been used or signed in.
# Only records of collectors present now are printed: removing a collector
# removes its agent even though its last record stays in the state dir.
#
# Same layout as Omarchy's omarchy-agent-usage-update, minus its multi-account
# handling: adding an agent means dropping in its collector, nothing else.
# The claude, codex, fireworks, grok and kimi collectors are vendored from
# Omarchy (see the header of each); agy is this repo's own.

state="${XDG_STATE_HOME:-$HOME/.local/state}/agent-usage"
mkdir -p "$state"
bindir=$(dirname "$(readlink -f "$0")")

pids=()
for collector in "$bindir"/agent-usage-*; do
	[ -x "$collector" ] || continue
	agent="${collector##*/agent-usage-}"
	(
		tmp=$(mktemp "$state/.$agent.XXXXXX")
		# A failed run keeps the previous record rather than blanking the agent
		if "$collector" "$@" >"$tmp" && jq -e . "$tmp" >/dev/null 2>&1; then
			mv "$tmp" "$state/$agent.json"
		else
			rm -f "$tmp"
			echo "agent-usage: $agent collector failed" >&2
		fi
	) &
	pids+=($!)
done
for pid in "${pids[@]}"; do wait "$pid"; done

agents=()
for collector in "$bindir"/agent-usage-*; do
	[ -x "$collector" ] || continue
	record="$state/${collector##*/agent-usage-}.json"
	[ -f "$record" ] && agents+=("$record")
done
if [ ${#agents[@]} -eq 0 ]; then
	echo "[]"
else
	jq -cs 'map(select(
		(.totalPrompts // 0) > 0 or (.totalSessions // 0) > 0
		or (.activeDays // 0) > 0 or (.todayPrompts // 0) > 0
		or (.todaySessions // 0) > 0 or ((.limits // []) | length > 0)
		or ((.accounts // []) | length > 0)
		or (.balance | . != null and . != false and . != 0 and . != "")
		or (.ready == true and (.tierLabel // "") != "")
	))' "${agents[@]}"
fi
