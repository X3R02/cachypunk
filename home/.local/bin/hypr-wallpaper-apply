#!/bin/sh
# Show the current theme's wallpaper: quickshell draws it on every screen, and
# hyprlock gets the same image.
#
# theme-set points ~/.config/theme/wallpaper at the active theme's image, so
# that link is the source of truth - nothing downstream should hardcode it.
# Quickshell reads the link itself at start and handles monitors plugged in
# later, so this only runs after the link changes (theme-set).

bg_img="$(readlink -f "$HOME/.config/theme/wallpaper" 2>/dev/null)"

[ -f "$bg_img" ] || exit 0

qs ipc call wallpaper reload >/dev/null 2>&1

# The lock screen shows the same image. hyprlock cannot glob the backgrounds
# dir and the filename changes with every theme, so hand it the resolved path
# through a variable file that hypr/hyprlock.conf sources.
{
	echo "# Generated by ~/.local/bin/hypr-wallpaper-apply - do not edit by hand."
	echo "# Holds the current wallpaper, so hyprlock can show the same one."
	echo "\$wallpaper = $bg_img"
} >"$HOME/.config/hypr/hyprlock-wallpaper.conf"
