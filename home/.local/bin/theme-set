#!/bin/bash
# Apply a color theme: theme-set [name]   (no name = re-apply the current one)
#
# Themes are fixed palettes in ~/.config/matugen/themes/<name>.json. matugen
# renders every app's color file from ~/.config/matugen/templates/, then this
# script reloads whatever doesn't watch its own config.

dir="$HOME/.config/matugen"

if [ "${1:-}" = "-l" ] || [ "${1:-}" = "--list" ]; then
	for f in "$dir"/themes/*.json; do basename "$f" .json; done
	exit 0
fi

name="${1:-$(cat "$dir/current" 2>/dev/null)}"
name="${name:-nightcity}"
theme="$dir/themes/$name.json"
if [ ! -f "$theme" ]; then
	echo "theme-set: no theme '$name'. Available:" >&2
	for f in "$dir"/themes/*.json; do echo "  $(basename "$f" .json)" >&2; done
	exit 1
fi

# matugen still wants a seed color; it is only used for the Material roles,
# which no template reads - the templates use the palette's own values.
accent=$(jq -r '.theme.accent' "$theme")
mkdir -p "$HOME/.config/theme"
matugen -q -c "$dir/config.toml" color hex "$accent" --import-json "$theme" || exit 1
# Templates can't know the home directory; walker's CSS needs absolute paths
# to its SVG pieces, so its template carries @HOME@ in their place
sed -i "s#@HOME@#$HOME#g" "$HOME/.config/walker/themes/matugen/style.css"
# Templates only get hex; a raw ANSI escape needs "r;g;b". A template writes
# @RGB:<key>@ (any key of the palette) and gets the decimal triple here
for f in "$HOME/.config/fastfetch/config.jsonc"; do
	[ -f "$f" ] || continue
	for key in $(grep -o '@RGB:[a-z0-9_]*@' "$f" | sort -u | sed 's/@RGB:\(.*\)@/\1/'); do
		hex=$(jq -r --arg k "$key" '.theme[$k] // empty' "$theme")
		hex=${hex#\#}
		[ ${#hex} = 6 ] || continue
		sed -i "s/@RGB:$key@/$((16#${hex:0:2}));$((16#${hex:2:2}));$((16#${hex:4:2}))/g" "$f"
	done
done
echo "$name" >"$dir/current"

# The wallpaper is part of the theme. hypr-wallpaper-apply resolves this link.
# First match wins:
#   1. this machine's own: ~/.config/cachypunk/wallpapers/<theme>.(jpg|png|...)
#      (outside the repo: personal images never get shared)
#   2. the theme's `wallpaper` key, if it names an existing file
#   3. one drawn from the palette (bg with a faint grid), so a fresh install
#      always has something that fits the theme
wallpaper=""
for f in "$HOME/.config/cachypunk/wallpapers/$name".{jpg,jpeg,png,webp}; do
	[ -f "$f" ] && wallpaper="$f" && break
done
if [ -z "$wallpaper" ]; then
	wallpaper=$(jq -r '.theme.wallpaper // empty' "$theme")
	wallpaper="${wallpaper/#\~/$HOME}"
fi
if [ ! -f "$wallpaper" ]; then
	wallpaper="$HOME/.local/share/cachypunk/wallpapers/$name.png"
	if [ ! -f "$wallpaper" ] || [ "$theme" -nt "$wallpaper" ]; then
		mkdir -p "${wallpaper%/*}"
		bg=$(jq -r '.theme.bg_deep // .theme.bg' "$theme")
		grid=$(jq -r '.theme.line' "$theme")
		# A 48px cell with its top and left edge in `line`, tiled at 35%
		magick -size 48x48 "xc:$bg" -fill "$grid" -draw "rectangle 0,0 47,0" \
			-draw "rectangle 0,0 0,47" -write mpr:cell +delete \
			-size 2560x1600 tile:mpr:cell "xc:$bg" +swap -compose blend \
			-define compose:args=35 -composite "$wallpaper"
	fi
fi
ln -sfn "$wallpaper" "$HOME/.config/theme/wallpaper"

# Brave theme: a Chromium theme extension wants RGB arrays, not hex, so it is
# built here rather than as a matugen template. Loaded once as an unpacked
# extension (brave://extensions, developer mode); Brave re-reads it from this
# dir on every start.
brave_dir="$HOME/.config/theme/brave-theme"
mkdir -p "$brave_dir"
jq --arg name "$name" '
	def rgb($k): .theme[$k] | ltrimstr("#") | [ .[0:2], .[2:4], .[4:6] ]
		| map(ascii_downcase | explode
			| map(if . >= 97 then . - 87 else . - 48 end) | .[0] * 16 + .[1]);
	{
		manifest_version: 3,
		name: "Matugen \($name)",
		version: "1.0",
		description: "Generated by theme-set from ~/.config/matugen/themes/\($name).json",
		theme: {
			colors: {
				frame: rgb("surface"),
				frame_inactive: rgb("bg"),
				frame_incognito: rgb("surface"),
				frame_incognito_inactive: rgb("bg"),
				background_tab: rgb("surface"),
				background_tab_inactive: rgb("bg"),
				toolbar: rgb("bg"),
				toolbar_text: rgb("fg"),
				toolbar_button_icon: rgb("fg"),
				tab_text: rgb("fg"),
				tab_background_text: rgb("fg_dim"),
				tab_background_text_inactive: rgb("muted"),
				bookmark_text: rgb("fg"),
				omnibox_background: rgb("surface"),
				omnibox_text: rgb("fg"),
				ntp_background: rgb("bg"),
				ntp_text: rgb("fg"),
				ntp_link: rgb("accent"),
				ntp_header: rgb("surface")
			},
			properties: { ntp_background_alignment: "bottom" }
		}
	}' "$theme" >"$brave_dir/manifest.json"

# Godot editor: theme colours written into its editor settings. Godot rewrites
# that file on exit, so it is only touched while Godot is closed.
godot_settings=$(ls "$HOME"/.config/godot/editor_settings-4*.tres 2>/dev/null | sort -V | tail -n1)
if [ -n "$godot_settings" ]; then
	if pgrep -x godot >/dev/null; then
		echo "theme-set: Godot is running; its editor colours update on the next theme-set" >&2
	else
		# "#rrggbb" -> "Color(r, g, b, 1)" with 0..1 channels
		godot_color() {
			local h=${1#\#}
			awk -v r=$((16#${h:0:2})) -v g=$((16#${h:2:2})) -v b=$((16#${h:4:2})) \
				'BEGIN { printf "Color(%.3f, %.3f, %.3f, 1)", r / 255, g / 255, b / 255 }'
		}
		base=$(godot_color "$(jq -r '.theme.bg' "$theme")")
		accent_c=$(godot_color "$(jq -r '.theme.accent' "$theme")")
		sed -i \
			-e 's|^interface/theme/color_preset = .*|interface/theme/color_preset = "Custom"|' \
			-e "s|^interface/theme/base_color = .*|interface/theme/base_color = $base|" \
			-e "s|^interface/theme/accent_color = .*|interface/theme/accent_color = $accent_c|" \
			-e 's|^interface/theme/corner_radius = .*|interface/theme/corner_radius = 0|' \
			"$godot_settings"
	fi
fi

# --- Reload what reads those files ------------------------------------------

# Hyprland re-reads lua/theme.lua (and so the border colors) on reload
hyprctl reload >/dev/null 2>&1

# Already-open ghostty windows don't re-read their config on their own.
# SIGUSR2 is ghostty's reload-config; a signal reaches every instance, while
# the D-Bus action only reached com.mitchellh.ghostty and missed the bar's
# floating terminals (--class=com.floatterm is a separate instance)
pkill -USR2 -x ghostty

# Folders in the theme's colour: theme-icons rebuilds the NightCity icon theme
# (Adwaita with recoloured folders). Bounce the name so running apps reload it.
"$HOME/.local/bin/theme-icons" "$theme"
gsettings set org.gnome.desktop.interface icon-theme Adwaita
gsettings set org.gnome.desktop.interface icon-theme NightCity

# Running GTK3/GTK4 apps (and Brave in GTK mode) only re-read gtk.css when the
# theme name changes, so bounce it through stock Adwaita and back.
gtk_theme=adw-gtk3-dark
gsettings set org.gnome.desktop.interface gtk-theme Adwaita
gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"

# qt5ct/qt6ct watch only their own config dir, not colors/ where matugen
# writes, so running Qt apps keep the old palette until the conf is touched.
# They re-apply ~3s later.
touch "$HOME/.config/qt5ct/qt5ct.conf" "$HOME/.config/qt6ct/qt6ct.conf"

# Obsidian has no global theme dir: drop the snippet into every known vault.
# It hot-reloads snippets, but enabling one is per vault, so turn it on in
# appearance.json too, with the dark base it styles (.theme-dark only).
jq -r '.vaults[].path' "$HOME/.config/obsidian/obsidian.json" 2>/dev/null |
	while IFS= read -r vault; do
		[ -d "$vault/.obsidian" ] || continue
		mkdir -p "$vault/.obsidian/snippets"
		cp "$HOME/.config/theme/obsidian.css" "$vault/.obsidian/snippets/matugen.css"
		appearance="$vault/.obsidian/appearance.json"
		[ -s "$appearance" ] || echo '{}' >"$appearance"
		jq '.theme = "obsidian"
			| .enabledCssSnippets = ((.enabledCssSnippets // []) - ["matugen"] + ["matugen"])' \
			"$appearance" >"$appearance.tmp" && mv "$appearance.tmp" "$appearance"
	done

# Quickshell hot-reloads Colors.qml by itself. Firefox reads its symlinked
# userChrome.css on its next start, Neovim likewise.

# Absolute path: a GUI launcher may not have ~/.local/bin on PATH
"$HOME/.local/bin/hypr-wallpaper-apply"

# SDDM (login screen after exiting Hyprland) can't read $HOME, so its theme
# lives in /usr/share with only these two files owned by this user; see
# ~/.config/sddm/matugen/install.sh. Skipped until that has been run.
sddm_theme=/usr/share/sddm/themes/matugen
if [ -w "$sddm_theme/theme.conf.user" ]; then
	cat "$HOME/.config/theme/sddm.conf" >"$sddm_theme/theme.conf.user"
	# Pre-blurred and darkened like hyprlock's background, so the greeter
	# doesn't have to blur at startup
	[ -f "$wallpaper" ] && magick "$wallpaper" -resize '1920x>' -blur 0x12 \
		-modulate 55 -quality 90 jpg:- >"$sddm_theme/background.jpg"
fi
